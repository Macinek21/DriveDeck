<Page
    x:Class="DriveDeck.App.LayoutEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark"
    Background="{StaticResource PageBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Background="{StaticResource BarBrush}" Padding="6,4">
            <StackPanel Orientation="Horizontal">
                <Button Content="&#xE72B;" Style="{StaticResource RailButton}" Click="Cancel_Click" />
                <TextBlock Text="Dashboard layout" FontSize="20" FontWeight="SemiBold" Margin="6,0" VerticalAlignment="Center" />
            </StackPanel>
            <Button Content="Save" Style="{StaticResource AccentButton}" Click="Save_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" />
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Body" Margin="14,10,14,40" MaxWidth="720" />
        </ScrollViewer>
    </Grid>
</Page>
