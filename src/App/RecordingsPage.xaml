<Page
    x:Class="DriveDeck.App.RecordingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark"
    Background="{StaticResource PageBrush}">
    <Page.Resources>
        <Style TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8,0" />
        </Style>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Background="{StaticResource BarBrush}" Padding="6,4">
            <StackPanel Orientation="Horizontal">
                <Button Content="&#xE72B;" Style="{StaticResource RailButton}" Click="Back_Click" />
                <TextBlock Text="Recordings" FontSize="20" FontWeight="SemiBold" Margin="6,0" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="EventsTab" Content="Incidents" Style="{StaticResource AccentButton}" Click="EventsTab_Click" Margin="0,0,6,0" />
                <Button x:Name="LoopTab" Content="Loop" Style="{StaticResource SoftButton}" Click="LoopTab_Click" Margin="0,0,4,0" />
            </StackPanel>
        </Grid>
        <Grid x:Name="EventsView" Grid.Row="1">
            <ListView x:Name="EventList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="List_ItemClick" Padding="4,8" />
            <TextBlock x:Name="EventsEmpty" Text="No saved incidents. Impacts and the red save button store footage here." TextWrapping="Wrap" Foreground="{StaticResource DimBrush}" Visibility="Collapsed" Margin="18" />
        </Grid>
        <Grid x:Name="LoopView" Grid.Row="1" Visibility="Collapsed">
            <ListView x:Name="LoopList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="List_ItemClick" Padding="4,8" />
            <TextBlock x:Name="LoopEmpty" Text="No loop recordings yet." Foreground="{StaticResource DimBrush}" Visibility="Collapsed" Margin="18" />
        </Grid>

        <Grid x:Name="Player" Grid.RowSpan="2" Visibility="Collapsed" Background="Black">
            <MediaElement x:Name="Media" AreTransportControlsEnabled="True" AutoPlay="True" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8">
                <Button Content="&#xE892;" Style="{StaticResource RailButton}" Click="Prev_Click" Background="#AA222B37" />
                <Button Content="&#xE893;" Style="{StaticResource RailButton}" Click="Next_Click" Background="#AA222B37" />
                <Button Content="&#xE72D;" Style="{StaticResource RailButton}" Click="Share_Click" Background="#AA222B37" />
                <Button Content="&#xE711;" Style="{StaticResource RailButton}" Click="ClosePlayer_Click" Background="#AA222B37" />
            </StackPanel>
            <TextBlock x:Name="PlayerTitle" Margin="14,18" VerticalAlignment="Top" HorizontalAlignment="Left" Foreground="#FFDDDDDD" />
        </Grid>
    </Grid>
</Page>
