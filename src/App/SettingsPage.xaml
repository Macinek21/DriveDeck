<Page
    x:Class="DriveDeck.App.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark"
    NavigationCacheMode="Enabled"
    Background="#FF0B0E12">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Background="#FF14181E">
            <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" Margin="16,10" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="8">
                <Button Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0" />
                <Button Content="Save" Click="Save_Click" Background="#FF3FA9F5" />
            </StackPanel>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Body" Margin="16,8,16,40" MaxWidth="640" HorizontalAlignment="Stretch" />
        </ScrollViewer>
    </Grid>
</Page>
