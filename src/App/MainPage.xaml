<Page
    x:Class="DriveDeck.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark"
    NavigationCacheMode="Required"
    Background="Black">

    <Grid x:Name="Root" Background="Black">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>


        <!-- Notification strip (top or bottom, set in Settings). Takes its own row so it never covers tiles. -->
        <Border x:Name="Strip" Grid.Row="0" Visibility="Collapsed" Tapped="Strip_Tapped" Padding="10,6"
                Background="#FF2B1A1A" BorderThickness="0,0,0,2" BorderBrush="#FFE81123">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StripGlyph" FontFamily="Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StripTitle" FontWeight="SemiBold" FontSize="15" Margin="0,0,10,0" />
                    <TextBlock x:Name="StripDetail" FontSize="14" Foreground="#FFBBBBBB" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="2" FontFamily="Segoe MDL2 Assets" Text="&#xE70D;" FontSize="14" VerticalAlignment="Center" Foreground="#FF999999" />
            </Grid>
        </Border>

        <FlipView x:Name="Pages" Grid.Row="1" Background="Black" SelectionChanged="Pages_SelectionChanged" />

        <!-- One live camera preview, laid over the camera tile of the visible page (never re-parented). Touches pass through. -->
        <Grid x:Name="PreviewLayer" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top" Width="1" Height="1"
              Opacity="0.01" IsHitTestVisible="False">
            <CaptureElement x:Name="Preview" Stretch="UniformToFill" />
            <TextBlock x:Name="RecBadge" FontSize="14" FontWeight="Bold" Foreground="#FFE81123" Margin="8,4,0,0"
                       HorizontalAlignment="Left" VerticalAlignment="Top" />
        </Grid>

        <!-- Collapsed notifications: small chip in the corner -->
        <Button x:Name="Chip" Grid.Row="1" Visibility="Collapsed" Click="Chip_Click" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,6,6,0" Padding="8,2" MinWidth="0" MinHeight="0" Background="#CC2B1A1A" BorderThickness="0">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ChipGlyph" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" />
                <TextBlock x:Name="ChipCount" FontSize="14" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <!-- Expanded notification list -->
        <Border x:Name="NoticePanel" Grid.Row="1" Visibility="Collapsed" Background="#F0101418" BorderBrush="#FF333A44" BorderThickness="1"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" MaxWidth="460" MaxHeight="320" CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="10,6">
                    <TextBlock Text="Notifications" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Clear" Click="ClearNotices_Click" MinHeight="0" Padding="10,2" Margin="0,0,6,0" />
                        <Button Content="Close" Click="CloseNotices_Click" MinHeight="0" Padding="10,2" />
                    </StackPanel>
                </Grid>
                <ListView x:Name="NoticeList" Grid.Row="1" SelectionMode="None" Padding="0,0,0,6">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="{Binding Glyph}" FontSize="16" Margin="0,2,0,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Detail}" FontSize="13" Foreground="#FFAAAAAA" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding TimeText}" FontSize="12" Foreground="#FF888888" Margin="8,2,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- Small floating controls -->
        <Button x:Name="SaveButton" Grid.Row="1" Click="Save_Click" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8"
                Width="52" Height="52" Padding="0" Background="#CCE81123" BorderThickness="0" ToolTipService.ToolTip="Save incident">
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72E;" FontSize="22" />
        </Button>
        <Button x:Name="MenuButton" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8"
                Width="44" Height="44" Padding="0" Background="#AA202630" BorderThickness="0">
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE712;" FontSize="18" />
            <Button.Flyout>
                <MenuFlyout>
                    <MenuFlyoutItem x:Name="RecToggle" Text="Stop recording" Click="RecToggle_Click" />
                    <MenuFlyoutItem Text="Fault codes" Click="Faults_Click" />
                    <MenuFlyoutItem Text="Recordings" Click="Recordings_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Edit dashboard layout" Click="Layout_Click" />
                    <MenuFlyoutItem Text="Settings" Click="Settings_Click" />
                </MenuFlyout>
            </Button.Flyout>
        </Button>

        <!-- Impact overlay -->
        <Grid x:Name="ImpactOverlay" Grid.RowSpan="3" Visibility="Collapsed" Background="#E6000000">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520" Margin="20">
                <TextBlock Text="Impact detected" FontSize="34" FontWeight="SemiBold" Foreground="#FFE81123" HorizontalAlignment="Center" />
                <TextBlock x:Name="ImpactDetail" FontSize="17" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,24" />
                <Button x:Name="CallButton" Click="Call_Click" HorizontalAlignment="Stretch" Height="64" Background="#FFE81123" Margin="0,0,0,12">
                    <TextBlock x:Name="CallText" FontSize="22" FontWeight="SemiBold" />
                </Button>
                <Button Content="I'm OK – dismiss" Click="DismissImpact_Click" HorizontalAlignment="Stretch" Height="52" FontSize="18" />
            </StackPanel>
        </Grid>

        <Border x:Name="NightDim" Grid.RowSpan="3" Background="Black" Opacity="0" IsHitTestVisible="False" />
    </Grid>
</Page>
